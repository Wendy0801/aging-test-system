# 字节码缓存（Python 特有的垃圾文件）
__pycache__/
*.py[cod]
*$py.class

# 虚拟环境（必须忽略，因为不同电脑路径不同）
venv/
.venv/
env/
ENV/

# 测试和覆盖率
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.dmypy.json
dmypy.json

# 数据库文件（防止把本地测试数据传上去）
*.db
*.sqlite3

# 环境变量（包含数据库密码、API密钥等）
.env

# 日志文件
*.log

# 打包文件
*.egg-info/
dist/
build/
*.egg

# IDE 配置
.vscode/
.idea/
*.swp

# 系统文件
.DS_Store
Thumbs.db